<!DOCTYPE html>
<html>
<head>
  <title>Registration Form</title>
</head>
<body>
  <h2>User Registration</h2>

  <% if (errors.length > 0) { %>
    <ul style="color:red">
      <% errors.forEach(function(e) { %>
        <li><%= e.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/register" method="POST" enctype="multipart/form-data">
    <p>Username: <input type="text" name="username" value="<%= old.username || '' %>"></p>
    <p>Password: <input type="password" name="password" value="<%= old.password || '' %>"></p>
    <p>Confirm Password: <input type="password" name="confirmPassword" value="<%= old.confirmPassword || '' %>"></p>
    <p>Email: <input type="text" name="email" value="<%= old.email || '' %>"></p>

    <p>Gender:
      <input type="radio" name="gender" value="Male" <%= old.gender == 'Male' ? 'checked' : '' %>> Male
      <input type="radio" name="gender" value="Female" <%= old.gender == 'Female' ? 'checked' : '' %>> Female
      <input type="radio" name="gender" value="Other" <%= old.gender == 'Other' ? 'checked' : '' %>> Other
    </p>

    <% const h = old.hobbies || []; %>
    <p>Hobbies:
      <input type="checkbox" name="hobbies" value="Reading" <%= h.includes('Reading') ? 'checked' : '' %>> Reading
      <input type="checkbox" name="hobbies" value="Music" <%= h.includes('Music') ? 'checked' : '' %>> Music
      <input type="checkbox" name="hobbies" value="Sports" <%= h.includes('Sports') ? 'checked' : '' %>> Sports
      <input type="checkbox" name="hobbies" value="Travelling" <%= h.includes('Travelling') ? 'checked' : '' %>> Travelling
    </p>

    <p>Profile Pic (single): <input type="file" name="profilePic"></p>
    <p>Other Pics (multiple, max 5): <input type="file" name="otherPics" multiple></p>
    <p><small>Note: files have to be selected again if there is an error (browsers don't allow refilling file inputs).</small></p>

    <button type="submit">Register</button>
  </form>
</body>
</html>
